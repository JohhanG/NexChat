      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.richa.nexchat"
    },
    "android": {
      "package": "com.richa.nexchat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00a884"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f3ba1ef2-6c67-49e4-9f30-882c0f8e0921"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f3ba1ef2-6c67-49e4-9f30-882c0f8e0921"
    }
  }
}
