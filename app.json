{
  "expo": {
    "name": "NexChat",
    "slug": "nexchat",
    "version": "1.0.0",
    "scheme": "nexchat",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b141a"
    },
